{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-lint.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/issue-todo-reminder.sh",
            "if": "Bash(git commit*)"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh release create:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./database/migrations/**)",
      "Bash(npx drizzle-kit migrate:*)",
      "Bash(npm run db:migrate:*)",
      "Bash(npx drizzle-kit push:*)"
    ]
  }
}
